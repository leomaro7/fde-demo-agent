{
  "env": {
    "AWS_REGION": "ap-northeast-1"
  },
  "permissions": {
    "allow": [
      "Bash(aws * --generate-cli-skeleton:*)",
      "Bash(aws * admin-get-*:*)",
      "Bash(aws * admin-list-*:*)",
      "Bash(aws * describe-*:*)",
      "Bash(aws * list-*:*)",
      "Bash(aws * lookup-*:*)",
      "Bash(aws --version)",
      "Bash(aws bedrock get-*:*)",
      "Bash(aws bedrock-agentcore-control get-harness:*)",
      "Bash(aws bedrock-runtime converse:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws xray get-trace-segment-destination:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir -p:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm test:*)",
      "Bash(npx cdk diff:*)",
      "Bash(npx cdk list:*)",
      "Bash(npx cdk synth:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(python3 .claude/skills/pre-commit-scrubber/scripts/scan.py:*)",
      "Bash(sed -n:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env)",
      "Bash(cat .env*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws ssm get-parameter:*)",
      "Bash(aws sts get-session-token:*)",
      "Bash(aws sts get-federation-token:*)",
      "Bash(aws ecr get-login-password:*)",
      "Bash(aws sts assume-role:*)",
      "Bash(aws iam create-access-key:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(aws * delete-*:*)",
      "Bash(aws * remove-*:*)",
      "Bash(aws * create-*:*)",
      "Bash(aws * update-*:*)",
      "Bash(aws * put-*:*)",
      "Bash(aws * start-*:*)",
      "Bash(npx cdk deploy:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api:*)",
      "Bash(rm:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "aws-core@claude-plugins-official": true,
    "aws-agents@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "deploy-on-aws@agent-plugins-for-aws": true
  }
}
