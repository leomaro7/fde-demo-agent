{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["infra/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "demos/**/*.ts", "scripts/**/*.ts"]
}
